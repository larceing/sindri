{
  "name": "sindri",
  "private": true,
  "version": "0.1.0",
  "description": "ERP + CRM open source para pymes industriales españolas. Web y escritorio, funciona sin internet.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @sindri/server dev",
    "dev:web": "pnpm --filter @sindri/web dev",
    "escritorio": "pnpm --filter @sindri/escritorio start"
  }
}
