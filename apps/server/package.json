    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@ariadna/core": "workspace:*",
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "pg": "^8.16.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5"
  }
}
