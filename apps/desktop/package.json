{
  "name": "@ariadna/desktop",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "Ariadna ERP para escritorio (Windows, macOS, Linux). Funciona sin internet.",
  "type": "module",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsc -p tsconfig.json && electron .",
    "dist": "pnpm build && electron-builder",
    "test": "echo \"(desktop) sin pruebas unitarias todavía\""
  },
  "dependencies": {
    "@ariadna/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "es.ariadnaerp.app",
    "productName": "Ariadna ERP",
    "files": ["dist/**", "package.json"],
    "extraResources": [{ "from": "../web/dist", "to": "web" }],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
